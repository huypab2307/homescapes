{
  "name": "homescapes-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Professional Homescapes save editor: server-side save algorithms plus a Windows client that drives ADB.",
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "server": "node --experimental-strip-types src/server/main.ts",
    "build": "tsc --noEmit && vite build && node tools/package_updates.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/engine/*.test.ts src/lib/api.test.ts src/server/session.test.ts",
    "preview": "vite preview",
    "start": "node --experimental-strip-types src/server/main.ts",
    "client": "node --experimental-strip-types src/server/gateway.ts",
    "test:licenses": "node --experimental-strip-types tools/verify_render.mjs",
    "test:owner": "node --experimental-strip-types tools/verify_owner.mjs",
    "test:updates": "node --experimental-strip-types tools/verify_updates.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.0"
  }
}
